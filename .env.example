# Copy to .env for local runs. On Streamlit Community Cloud put the same names in App settings > Secrets
# (TOML: NAME = "value"). On Azure set them under App Service > Settings > Environment variables.

# Login. Username defaults to Customer. Make the hash with: python src/security/auth.py
APP_USERNAME=Customer
APP_PASSWORD_HASH=

# Model: set GROQ_* (free, console.groq.com > API Keys) or AZURE_OPENAI_*. Groq wins when both are set.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0

# Azure OpenAI (Azure AI Foundry > your resource > Keys and Endpoint; deployment = your model deployment name)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# Leave empty for models that reject temperature (reasoning models).
# AZURE_OPENAI_TEMPERATURE=0

# Optional limits (defaults shown)
# LIMIT_SESSIONS_PER_IP_10MIN=30
# LIMIT_LOGIN_FAILURES_15MIN=5
# LIMIT_QUESTIONS_PER_IP_HOUR=20
# LIMIT_QUESTIONS_PER_DAY=500
# LIMIT_QUESTION_CHARS=500
